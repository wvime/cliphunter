# Copy this file to .env and fill in only what you use.
# Phase 1 does not call Anthropic. The key is reserved for the later scorer.
# Never commit .env. It is gitignored.

# Optional in phase 1. Live detection does not spend YouTube quota.
# Used only if a live title cannot be read for free (videos.list = 1 unit).
YOUTUBE_API_KEY=

# Required only to watch Twitch channels (Helix app token).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Unused in phase 1. Later phases use it for the Claude scorer.
ANTHROPIC_API_KEY=
